# Copy to /etc/zeus/control-plane.env and replace every placeholder.
# Keep this file root:root mode 0600. Never commit the populated file.
ZEUS_ENV=production
ZEUS_VERSION=0.4.0-alpha

# Admin/browser API is private to the local TLS reverse proxy.
ZEUS_HTTP_ADDR=127.0.0.1:8080
ZEUS_ALLOWED_ORIGINS=https://admin.example.com

# PostgreSQL must be dedicated to ZEUS and reachable only from this service.
# URL-encode reserved characters in the username/password.
ZEUS_DATABASE_URL=postgres://zeus_app:REPLACE_PASSWORD@db.example.com:5432/zeus?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# Cognito outputs: OidcIssuer and OidcClientId.
ZEUS_OIDC_ISSUER=https://cognito-idp.REPLACE_REGION.amazonaws.com/REPLACE_USER_POOL_ID
ZEUS_OIDC_CLIENT_ID=REPLACE_PUBLIC_APP_CLIENT_ID

# Separate mTLS listener for VPN nodes. Restrict TCP/8443 at the firewall
# to the registered staging node IPs only. Prefer a private interface IP
# instead of 0.0.0.0 when both hosts share a private network.
ZEUS_NODE_HTTP_ADDR=0.0.0.0:8443
ZEUS_NODE_TLS_CERT_FILE=/etc/zeus/node-listener/server.crt
ZEUS_NODE_TLS_KEY_FILE=/etc/zeus/node-listener/server.key
ZEUS_NODE_CA_FILE=/etc/zeus/node-listener/node-client-ca.crt

# First-owner bootstrap only: add both variables for the first startup,
# then remove both lines immediately after an active owner is created.
# ZEUS_BOOTSTRAP_ADMIN_LOGIN=owner
# ZEUS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_32_PLUS_CHAR_SECRET
