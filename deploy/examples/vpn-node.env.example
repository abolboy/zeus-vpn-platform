# Copy to /etc/zeus/vpn-node.env on the STAGING WireGuard node.
# Keep this file root:root mode 0600. Never commit the populated file.
ZEUS_CONTROL_PLANE_URL=https://control-plane.example.com:8443
ZEUS_NODE_CLIENT_CERT_FILE=/etc/zeus-node/client.crt
ZEUS_NODE_CLIENT_KEY_FILE=/etc/zeus-node/client.key
# Trust bundle for the HTTPS certificate served by the Control Plane listener.
ZEUS_NODE_SERVER_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Keep false until the isolated staging node is backed up and reviewed.
ZEUS_NODE_ALLOW_MUTATIONS=false
ZEUS_NODE_POLL_INTERVAL=5s

ZEUS_WG_INTERFACE=wg0
ZEUS_WG_CONFIG_PATH=/etc/wireguard/wg0.conf
ZEUS_WG_BINARY=/usr/bin/wg
ZEUS_IP_BINARY=/usr/sbin/ip

# EXAMPLE POOLS ONLY. Replace with ranges checked against interface IPs,
# existing peer AllowedIPs, private routes, and the real allocation plan.
ZEUS_WG_IPV4_POOL=10.77.77.0/24
ZEUS_WG_IPV6_POOL=fd77:77:77::/64
