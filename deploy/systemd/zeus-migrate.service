[Unit]
Description=ZEUS Control Plane database migration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=zeus
Group=zeus
Environment=ZEUS_ENV=production
EnvironmentFile=/etc/zeus/database-migrate.env
ExecStart=/opt/zeus/bin/zeus-migrate
TimeoutStartSec=5min
UMask=0077

NoNewPrivileges=yes
# Prevent the service process from obtaining EC2 instance-profile credentials via IMDS.
IPAddressDeny=169.254.169.254/32
IPAddressDeny=fd00:ec2::254/128
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
